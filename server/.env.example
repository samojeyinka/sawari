# Server environment. Copy to .env and fill in real values.
# The .env file itself must never be committed.

NODE_ENV=development
PORT=4000

# Public URL of the frontend (CORS + OAuth redirect target).
FRONTEND_URL=http://localhost:5173
# Base URL of this API, used to build OAuth callback URLs (format: <base>/api/v1/auth/<provider>/callback).
OAUTH_REDIRECT_BASE=http://localhost:4000

# MongoDB connection string (paste yours here).
MONGODB_URI=mongodb://127.0.0.1:27017/sawari
# Separate database used by the integration tests (leave empty to skip them).
TEST_MONGODB_URI=

# JWT signing. Expires like "7d" or seconds.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Cookie options
# COOKIE_DOMAIN=

# OAuth (GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email (Resend). Leave RESEND_API_KEY empty to log emails instead of
# sending them (dev/tests). MAIL_FROM default is Resend's test sender, which can
# only deliver to your own verified address until you add a domain.
RESEND_API_KEY=
MAIL_FROM=Sawari <onboarding@resend.dev>
# Set to false to force-disable sending even when a key is present.
MAIL_ENABLED=true

# AI generation (DeepSeek, OpenAI-compatible chat completions endpoint).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Background job worker (Mongo-backed queue).
QUEUE_POLL_MS=2000
QUEUE_MAX_ATTEMPTS=3

# Reminder scheduler (session reminders + weekly summary).
# Set SCHEDULER_ENABLED=false to run the API without sending scheduled mail.
SCHEDULER_ENABLED=true
# How often the scheduler checks for due reminders (ms).
SCHEDULER_POLL_MS=60000